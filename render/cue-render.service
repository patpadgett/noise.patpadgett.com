# CUE render box as a user service: systemctl --user enable --now cue-render
# Install: mkdir -p ~/.config/systemd/user && cp render/cue-render.service ~/.config/systemd/user/ && systemctl --user daemon-reload
#          loginctl enable-linger $USER      (so it runs without a login session)
# The token lives in ~/.config/cue-render/env as CUE_RENDER_TOKEN=... (chmod 600). ComfyUI must be up on :8188.
[Unit]
Description=CUE render box (Wan 2.2 5B via ComfyUI)
After=network-online.target comfyui.service
Wants=comfyui.service

[Service]
Type=simple
EnvironmentFile=%h/.config/cue-render/env
Environment=CUE_RENDER_BACKEND=comfy
Environment=CUE_RENDER_HOST=127.0.0.1
Environment=CUE_RENDER_PORT=8790
Environment=CUE_RENDER_WORK=%h/.cache/cue-render
Environment=PATH=/data/pat/.hermes/tools/ffmpeg-9.0.1-linux-x64/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/data/pat/2_PUBLISHED/noise.patpadgett.com
ExecStart=/usr/bin/env python3 render/cue_render.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
